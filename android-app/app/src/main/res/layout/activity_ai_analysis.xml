<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp"
        android:layoutAnimation="@anim/layout_list">

        <!-- Context header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.QualityInspect.Card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_ai" android:tint="@color/primary"
                        android:contentDescription="AI analysis" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI ANALYSIS" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.QualityInspect.Label"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_ai_context" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="15sp"
                    android:lineSpacingExtra="5dp" android:textColor="@color/on_surface"
                    android:padding="14dp" android:text="Loading…" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Evidence image -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_evidence"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.QualityInspect.Card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_camera" android:tint="@color/secondary"
                        android:contentDescription="Evidence" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="EVIDENCE" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.QualityInspect.Label"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_margin="10dp">
                    <ImageView android:id="@+id/iv_evidence"
                        android:layout_width="match_parent" android:layout_height="220dp"
                        android:background="@color/surface_variant"
                        android:scaleType="centerInside"
                        android:contentDescription="Evidence image" />
                    <ProgressBar android:id="@+id/pb_image"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:layout_gravity="center" android:visibility="visible" />
                </FrameLayout>
                <TextView android:id="@+id/tv_image_meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="10dp"
                    android:text="Loading image…" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Model verdict -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_verdict"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.QualityInspect.Card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_shield" android:tint="@color/primary"
                        android:contentDescription="Verdict" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MODEL VERDICT" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.QualityInspect.Label"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_verdict_empty" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="14sp"
                    android:textColor="@color/on_surface_variant"
                    android:padding="14dp" android:text="No model result yet"
                    android:visibility="gone" />
                <TextView android:id="@+id/tv_verdict_class" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="26sp"
                    android:textStyle="bold" android:textColor="@color/primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp"
                    android:visibility="gone" />
                <TextView android:id="@+id/tv_verdict_score" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/on_surface"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="4dp"
                    android:visibility="gone" />
                <TextView android:id="@+id/tv_verdict_meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/on_surface_variant" android:lineSpacingExtra="4dp"
                    android:padding="14dp" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Processing attempts -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_attempts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.QualityInspect.Card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_refresh" android:tint="@color/warning"
                        android:contentDescription="Attempts" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PROCESSING ATTEMPTS" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.QualityInspect.Label"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/ll_attempts"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Inspection-mode actions -->
        <LinearLayout android:id="@+id/ll_actions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rerun"
                style="@style/Widget.QualityInspect.Button.Tonal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Re-run AI analysis" android:layout_marginBottom="10dp"
                app:icon="@drawable/ic_refresh" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_inspection"
                style="@style/Widget.QualityInspect.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Open inspection record" android:layout_marginBottom="14dp"
                app:icon="@drawable/ic_shield" app:iconGravity="textStart" />
        </LinearLayout>

        <!-- GenAI assistant -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.QualityInspect.Card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_actions" android:tint="@color/secondary"
                        android:contentDescription="GenAI" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GENAI ASSISTANT" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.QualityInspect.Label"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_genai_batch" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.QualityInspect.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:hint="Ask about this batch…">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ask"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:paddingBottom="6dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_summary"
                        style="@style/Widget.QualityInspect.Button.Tonal"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="Batch summary" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ask"
                        style="@style/Widget.QualityInspect.Button.Outlined"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="Ask AI" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <ProgressBar android:id="@+id/pb_genai"
                        android:layout_width="20dp" android:layout_height="20dp"
                        android:visibility="gone" />
                    <TextView android:id="@+id/tv_genai_meta"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView android:id="@+id/tv_genai" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:fontFamily="monospace" android:textColor="#E2E8F0"
                    android:background="@drawable/bg_console" android:padding="14dp"
                    android:layout_margin="10dp" android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:text="Tap Batch summary to generate an evidence-grounded report for this batch." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_download_pdf"
                    style="@style/Widget.QualityInspect.Button.Outlined"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="Download PDF report"
                    app:icon="@drawable/ic_actions" app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product-mode: recent inspections -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_inspections"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Widget.QualityInspect.Card" android:layout_marginBottom="14dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_review" android:tint="@color/primary"
                        android:contentDescription="Inspections" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RECENT INSPECTIONS" android:textSize="12sp"
                        android:textAppearance="@style/TextAppearance.QualityInspect.Label"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/ll_inspections"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
