# ============================================================
# QualityInspect AI - environment template
# Copy to `.env` (never commit the real file). No real secrets.
# ============================================================

# ---------- Backend (Spring Boot) ----------
APP_ENV=dev
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/qualityinspect
DB_USER=qualityinspect
DB_PASSWORD=change_me_db_password

# JWT - MUST be >= 32 chars in any shared environment
APP_JWT_SECRET=dev_only_change_me_to_a_long_random_secret_32plus
APP_JWT_ACCESS_MINUTES=30
APP_JWT_REFRESH_DAYS=7

# Dev-only bootstrap of the first QUALITY_MANAGER account.
# Keep false in production; the endpoint is refused when false.
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_USERNAME=qm.admin
APP_BOOTSTRAP_PASSWORD=ChangeMe!qm1
APP_BOOTSTRAP_ORG=demo-org

# Private image/evidence storage
STORAGE_DIR=./storage
MAX_IMAGE_BYTES=10485760

# CORS for the Android emulator / dev tools
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://10.0.2.2:8080

# ---------- ML service (FastAPI) ----------
ML_PORT=8000
ML_MODEL_PATH=./artifacts/model.pt
ML_MODEL_META=./artifacts/metadata.json
ML_DEVICE=cpu

# ---------- Generative AI (server-side only; NEVER in the APK) ----------
# provider: openai-compatible | none
GENAI_PROVIDER=none
GENAI_BASE_URL=https://api.openai.com/v1
GENAI_API_KEY=
GENAI_MODEL=gpt-4o-mini
GENAI_TEMPERATURE=0.1
GENAI_TIMEOUT_SECONDS=45

# ---------- Backend -> ML ----------
ML_SERVICE_URL=http://localhost:8000
